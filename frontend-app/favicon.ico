import Head from "next/head";
export default function RootLayout({ children }: { children: React.ReactNode }) {
  return (
    <html lang="en">
      <head>
        <link rel="icon" href="/favicon.ico" />
        <title>Wellness Connect | Rishiverse</title>
      </Head>
      <body>{children}</body>
    </html>
  );
}
